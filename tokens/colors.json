{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "super-apple-design-colors",
  "version": "2.0.0",
  "description": "Adaptive semantic color system conforming to Apple Human Interface Guidelines with WCAG AA compliance",
  "tokens": {
    "canvas": {
      "primary": { "light": "#FFFFFF", "dark": "#000000", "description": "Base app background" },
      "secondary": { "light": "#F2F2F7", "dark": "#1C1C1E", "description": "Grouped table/card canvas" },
      "tertiary": { "light": "#FFFFFF", "dark": "#2C2C2E", "description": "Elevated grouped content" }
    },
    "surface": {
      "base": { "light": "rgba(255, 255, 255, 0.8)", "dark": "rgba(30, 30, 32, 0.75)", "description": "Control layer default surface" },
      "elevated": { "light": "#FFFFFF", "dark": "#1C1C1E", "description": "Modal sheets and popovers" },
      "grouped": { "light": "#FFFFFF", "dark": "#2C2C2E", "description": "Settings lists and cards" }
    },
    "label": {
      "primary": { "light": "#000000", "dark": "#FFFFFF", "contrastRatio": "21:1", "description": "Primary high-emphasis text" },
      "secondary": { "light": "rgba(60, 60, 67, 0.60)", "dark": "rgba(235, 235, 245, 0.60)", "contrastRatio": "4.6:1", "description": "Secondary subheaders and captions" },
      "tertiary": { "light": "rgba(60, 60, 67, 0.30)", "dark": "rgba(235, 235, 245, 0.30)", "contrastRatio": "3.1:1", "description": "Muted placeholders and subtle icons" },
      "quaternary": { "light": "rgba(60, 60, 67, 0.18)", "dark": "rgba(235, 235, 245, 0.18)", "description": "Disabled states and inactive fills" }
    },
    "separator": {
      "opaque": { "light": "#C6C6C8", "dark": "#38383A", "description": "Hairline continuous borders" },
      "nonOpaque": { "light": "rgba(60, 60, 67, 0.29)", "dark": "rgba(84, 84, 88, 0.65)", "description": "Translucent card separators" }
    },
    "accents": {
      "blue": { "light": "#007AFF", "dark": "#0A84FF", "description": "Primary interactive tint" },
      "purple": { "light": "#AF52DE", "dark": "#BF5AF2", "description": "Creative & premium actions" },
      "pink": { "light": "#FF2D55", "dark": "#FF375F", "description": "Highlights and tags" },
      "green": { "light": "#34C759", "dark": "#30D158", "description": "Success and verification" },
      "yellow": { "light": "#FFCC00", "dark": "#FFD60A", "description": "Warning and caution" },
      "orange": { "light": "#FF9500", "dark": "#FF9F0A", "description": "Pending and attention" },
      "red": { "light": "#FF3B30", "dark": "#FF453A", "description": "Destructive and error actions" },
      "gray": { "light": "#8E8E93", "dark": "#8E8E93", "description": "Neutral controls" }
    },
    "materials": {
      "ultraThin": {
        "light": "rgba(255, 255, 255, 0.55)",
        "dark": "rgba(20, 20, 22, 0.55)",
        "blur": "20px",
        "saturate": "180%"
      },
      "regular": {
        "light": "rgba(255, 255, 255, 0.72)",
        "dark": "rgba(28, 28, 30, 0.75)",
        "blur": "25px",
        "saturate": "190%"
      },
      "thick": {
        "light": "rgba(255, 255, 255, 0.90)",
        "dark": "rgba(36, 36, 38, 0.88)",
        "blur": "32px",
        "saturate": "200%"
      }
    }
  }
}
